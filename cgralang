#!/bin/sh -eu

X=4
Y=4
R=10
LOG_LEVEL=WARNING
while getopts "f:x:y:r:l:" opt; do
  case $opt in
    f) F=$OPTARG ;;
    x) X=$OPTARG ;;
    y) Y=$OPTARG ;;
    r) R=$OPTARG ;;
    l) LOG_LEVEL=$OPTARG;;
    \?) echo "Invalid option -$OPTARG" >&2; exit 1 ;;
  esac
done

echo "$X"
echo "$Y"
./llvm-project/build/bin/clang -O3 -fno-unroll-loops -fno-vectorize -fno-slp-vectorize -S -emit-llvm -o extracted.ll "$F"
./llvm-project/build/bin/opt -disable-output extracted.ll -passes=cgra-extract

for folder in acc*; do
    if [ -d "$folder" ]; then
        python3 -m mapper.main --log $LOG_LEVEL --log-file cgra-code-"$folder".log -path "$folder"/ -x "$X" -y "$Y" -r "$R" -no_assembly 1
    fi
done

rm -r acc*
rm extracted.ll
